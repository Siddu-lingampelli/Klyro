{
  "name": "klyro",
  "version": "0.1.0",
  "description": "Klyro — autonomous coding harness CLI that streams from any OpenAI-compatible or Anthropic LLM endpoint.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "klyro": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "llm",
    "ai",
    "cli",
    "openai",
    "streaming"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  }
}
